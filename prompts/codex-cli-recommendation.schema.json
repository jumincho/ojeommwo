{
  "type": "object",
  "additionalProperties": false,
  "required": ["recommendations", "researchStats"],
  "properties": {
    "recommendations": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["category", "restaurant", "menu", "priceText", "comment", "evidence"],
        "properties": {
          "category": {
            "type": "string",
            "enum": ["한식", "치킨", "분식", "돈까스", "족발/보쌈", "찜/탕", "구이", "피자", "중식", "일식", "회/해물", "양식", "아시안", "샌드위치", "샐러드", "버거", "멕시칸", "도시락", "죽"]
          },
          "restaurant": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          },
          "menu": {
            "type": "string",
            "minLength": 2,
            "maxLength": 120
          },
          "priceText": {
            "type": "string",
            "minLength": 2,
            "maxLength": 32,
            "pattern": "^(?:가격 확인 필요|(?:[0-9]{1,3}(?:,[0-9]{3})+|[0-9]{4,6})원(?:\\s*\\/\\s*[0-9]+g)?)$"
          },
          "comment": {
            "type": "string",
            "minLength": 35,
            "maxLength": 120
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 6,
            "items": {
              "type": "string",
              "maxLength": 2048,
              "pattern": "^https://"
            }
          }
        }
      }
    },
    "researchStats": {
      "type": "object",
      "additionalProperties": false,
      "required": ["broadSearches", "verificationSearches", "totalSearches", "notes"],
      "properties": {
        "broadSearches": {
          "type": "integer",
          "minimum": 0
        },
        "verificationSearches": {
          "type": "integer",
          "minimum": 0
        },
        "totalSearches": {
          "type": "integer",
          "minimum": 0
        },
        "notes": {
          "type": "string",
          "maxLength": 300
        }
      }
    }
  }
}
