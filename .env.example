# Slack tokens. Do not store real values here.
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
SLACK_API_TIMEOUT_MS=15000
ENABLE_MEAL_FEEDBACK=false
ENABLE_OBSERVATORY_LINK=true
OBSERVATORY_URL=https://ojeommwo-observatory.jumincho.chatgpt.site/
# When this file exists, its single validated URL takes precedence over OBSERVATORY_URL.
OBSERVATORY_URL_FILE=observatory/runtime/public-url.txt
INTERACTION_RECONNECT_MAX_MS=30000

# Production channel for scheduled lunch/dinner posts.
LUNCH_CHANNEL_ID=C0123456789

# Optional app DM or separate channel for scheduled-job failure alerts.
OPERATIONS_ALERT_CHANNEL_ID=D0123456789

# Keep disabled when using pororo cron or emergency Windows tasks.
ENABLE_SCHEDULE=false

# Optional cleanup of old bot messages. Disabled by default.
ENABLE_CLEANUP=false
KEEP_RECENT_MESSAGES=10

# Recommendation mode:
# - codex-cli: use local Codex CLI/OAuth usage with web_search, then local cache fallback on failure
# - cache: production and emergency delivery path; deterministic and preference-aware
# - codex-cli/static: explicit dry-run diagnostics only for scheduled delivery
RECOMMENDATION_MODE=cache
CODEX_CLI_PATH=
# Persistent service OAuth source. Never point this at an interactive ~/.codex.
CODEX_CLI_AUTH_PATH=/root/.ojeommwo-v2-state/codex/auth.json
CODEX_CLI_MODEL=gpt-6-luna
CODEX_CLI_REASONING_EFFORT=xhigh
CODEX_CLI_SANDBOX=read-only
CODEX_CLI_ISOLATE_LINUX=true
CODEX_CLI_ISOLATION_UID=65534
CODEX_CLI_ISOLATION_GID=65534
CODEX_CLI_TIMEOUT_MS=180000
CODEX_CLI_USE_SEARCH=true
CODEX_CLI_FALLBACK_TO_CACHE=true
CACHE_FALLBACK_MIN_CANDIDATES=20
CACHE_HISTORY_MAX_AGE_DAYS=30
RECOMMENDATION_COUNT=3
ALLOW_UNVERIFIED_FALLBACK=false
POLICY_ENFORCEMENT_SINCE=2026-07-12T00:00:00+09:00
CHOICE_DIVERSITY_ENFORCEMENT_SINCE=2026-08-21T00:00:00+09:00
RUNTIME_LOG_RETENTION_DAYS=45
CODEX_RUN_RETENTION_DAYS=30

RESTAURANT_COOLDOWN_DAYS=14
MENU_COOLDOWN_DAYS=7
HISTORY_RETENTION_DAYS=90
MEAL_EVENT_RETENTION_DAYS=730
TASTE_EXPLORATION_RATE=0.18
TASTE_HALF_LIFE_DAYS=180
# Symmetric Beta(4,4) prior: one or two feedback events move taste gradually.
TASTE_PRIOR_ALPHA=3
CANDIDATE_PREFERENCE_WEIGHT=0.9
CANDIDATE_PREFERENCE_RETENTION_DAYS=730
COFFEE_PARTICIPATION_RETENTION_DAYS=30

# Custom meal records are acknowledged immediately, then normalized in the
# background by Luna/xhigh with web search. The timeout is a rare-job ceiling.
MEAL_NORMALIZATION_ENABLED=true
MEAL_NORMALIZATION_TIMEOUT_MS=240000
MEAL_NORMALIZATION_MAX_ATTEMPTS=3
MEAL_NORMALIZATION_RETRY_INTERVAL_MS=1800000

# Engineering Building 7 delivery target and candidate-refresh policy.
TARGET_LATITUDE=35.8461205
TARGET_LONGITUDE=127.1340012
RESEARCH_DISTANCE_KM=6
RESEARCH_PRICE_TTL_DAYS=7
RESEARCH_DELIVERY_TTL_DAYS=3
RESEARCH_MIN_CANDIDATES=3
RESEARCH_CODEX_TIMEOUT_MS=600000

# Official Korean weather contract for the JBNU Engineering Building 7 target.
# Apply for all five data.go.kr services before enabling weather:
# - 기상청_단기예보 조회서비스
# - 기상청_기상특보 조회서비스
# - 기상청_생활기상지수 조회서비스(4.0)
# - 한국환경공단_에어코리아_대기오염정보
# - 한국환경공단_에어코리아_미세먼지 경보 발령 현황
WEATHER_ENABLED=false
WEATHER_FETCH_TIMEOUT_MS=15000
WEATHER_RAIN_THRESHOLD_PERCENT=50
WEATHER_PM10_THRESHOLD=80
WEATHER_PM25_THRESHOLD=35
PUBLIC_DATA_SERVICE_KEY=
AIRKOREA_STATION_NAME=노송동

# Fixed operating settings.
TIMEZONE=Asia/Seoul
LOCATION_NAME=전북대학교 공과대학 7호관
